# --- Sonari .gitignore ---
# The heavy stuff below is re-created by setup.bat / setup.sh on each machine,
# so it must NOT be committed (keeps the repo small enough for GitHub/Drive).

# Python virtual environment (~900 MB)
venv/
.venv/
env/

# Downloaded model weights (~1.7 GB) — re-fetched by download_models.py
models/

# Demucs vocal-separation output (audio stems)
separated/

# Your audio inputs and text outputs (keep the folders, ignore the contents)
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Private personal notes / roadmap (never published)
NOTES.md
